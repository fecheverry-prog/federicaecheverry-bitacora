# 13. Graficos de densidad (KDE): sanos vs enfermos
# Comparamos la distribución de presión, edad e IMC entre pacientes con y sin ECV
# Los picos indícan donde se concentran los valores y las lineas punteadas muestran las medianas

from scipy.stats import gaussian_kde

NARANJA, AZUL = "#D85A30", "#4C72B0"
sanos = datos_limpios[datos_limpios["cardio"] == 0]
enfermos = datos_limpios[datos_limpios["cardio"] == 1]

variables = {
    "ap_hi":      ("Presión sistólica", "mmHg", 0.35),
    "age_number": ("Edad", "años", 0.25),
    "imc":        ("IMC", "kg/m²", 0.20),
}

fig, axes = plt.subplots(3, 1, figsize=(11, 11))

for ax, (columna, (nombre, unidad, suavizado)) in zip(axes, variables.items()):
    # Rango del eje X: del 1% al 99% de los pacientes (dejamos afuera los extremos)
    x = np.linspace(datos_limpios[columna].quantile(0.01),
                    datos_limpios[columna].quantile(0.99), 400)

    for grupo, color, etiqueta in [(sanos, AZUL, "Sin ECV"), (enfermos, NARANJA, "Con ECV")]:
        curva = gaussian_kde(grupo[columna], bw_method=suavizado)(x)
        ax.fill_between(x, curva, color=color, alpha=0.35)
        ax.plot(x, curva, color=color, linewidth=2.5, label=etiqueta)

        # Línea vertical en la mediana, con su valor arriba
        mediana = grupo[columna].median()
        altura = gaussian_kde(grupo[columna], bw_method=suavizado)(mediana)[0]
        ax.vlines(mediana, 0, altura, color=color, linestyle="--", linewidth=2)
        ax.text(mediana, altura * 1.04, f"{mediana:.0f}", color=color,
                ha="center", va="bottom", fontsize=13, fontweight="bold")

    diferencia = enfermos[columna].median() - sanos[columna].median()
    ax.set_title(f"{nombre}: los enfermos tienen {diferencia:.0f} {unidad} más (mediana)",
                 fontsize=14, loc="left", fontweight="bold")
    ax.set_xlabel(f"{nombre} ({unidad})", fontsize=11)
    ax.set_yticks([])                      # la altura exacta no importa, solo la forma
    ax.set_ylim(0, ax.get_ylim()[1] * 1.15)
    for lado in ("top", "right", "left"):
        ax.spines[lado].set_visible(False)

axes[0].legend(loc="upper right", frameon=False, fontsize=12)
fig.suptitle("¿En qué se diferencian los pacientes con y sin enfermedad cardiovascular?",
             fontsize=16, y=1.0)
plt.tight_layout()
plt.show()

# PRESIÓN: es la variable que mejor diferencia ambos grupos; los enfermos presentan valores más altos (130-160).
# EDAD: los enfermos tienden a ser mayores, aunque las distribuciones se superponen bastante.
# IMC: los enfermos se concentran más en valores de sobrepeso (IMC > 25), pero la diferencia es menor.



# 14. Mapa de riesgo: edad y presion arterial
# Combinamos grupos de edad y categorias de precsion para calcular el porcentaje de pacientes con ECV
# Excluimos los grupos con menos de 30 pacientes para que el mapa sea más confiable

from matplotlib.colors import LinearSegmentedColormap


datos_limpios["grupo_edad"] = pd.cut(
    datos_limpios["age_number"], bins=[0, 40, 45, 50, 55, 60, 120], right=False,
    labels=["<40", "40-44", "45-49", "50-54", "55-59", "60+"]
)

nombres_presion = {2: "Normal", 3: "Elevada", 4: "HTA 1", 5: "HTA 2", 6: "Crisis"}

tabla = (datos_limpios[datos_limpios["categoria_presion"].isin(nombres_presion.keys())]
         .groupby(["categoria_presion", "grupo_edad"], observed=True)["cardio"]
         .agg(["mean", "size"]))
porcentaje = (tabla["mean"] * 100).unstack("grupo_edad")
cantidad = tabla["size"].unstack("grupo_edad")
porcentaje = porcentaje.where(cantidad >= 30)          # ocultamos grupos con menos de 30 pacientes
porcentaje = porcentaje.rename(index=nombres_presion).iloc[::-1]   # presión más alta arriba

colores = LinearSegmentedColormap.from_list("riesgo", ["#4C72B0", "#F4F1EC", "#D85A30", "#8B1A1A"])

fig, ax = plt.subplots(figsize=(11, 6))
imagen = ax.imshow(porcentaje, cmap=colores, vmin=0, vmax=100, aspect="auto")

for fila in range(porcentaje.shape[0]):
    for col in range(porcentaje.shape[1]):
        valor = porcentaje.iloc[fila, col]
        if pd.notna(valor):
            color_texto = "white" if valor < 15 or valor > 65 else "black"
            ax.text(col, fila, f"{valor:.0f}%", ha="center", va="center",
                    fontsize=14, fontweight="bold", color=color_texto)

ax.set_xticks(range(porcentaje.shape[1]), porcentaje.columns, fontsize=12)
ax.set_yticks(range(porcentaje.shape[0]), porcentaje.index, fontsize=12)
ax.set_xlabel("Edad (años)  →  más edad", fontsize=12)
ax.set_ylabel("Presión arterial  →  más presión", fontsize=12)
ax.set_title("Mapa de riesgo: % de pacientes con ECV según edad y presión",
             fontsize=15, fontweight="bold", pad=15)
for lado in ax.spines.values():
    lado.set_visible(False)

barra = fig.colorbar(imagen, ax=ax, shrink=0.8)
barra.set_label("% de pacientes con ECV", fontsize=11)
plt.tight_layout()
plt.show()

# EDAD Y PRESIÓN: el porcentaje de ECV aumenta cuando ambas variables son mayores.
# PRESIÓN: parece tener una relación más fuerte con la ECV que la edad.
# COMBINACIÓN: con presión normal y menos de 40 años, el 8% tiene ECV, mientras que con HTA 2 y 60 años o más, el porcentaje alcanza el 81%.